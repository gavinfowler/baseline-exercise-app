                "distance": 4.6,
                "intervals": [
                  {
                    "label": "Warm-up",
                    "repeat": 1,
                    "workSeconds": 600,
                    "workPace": "10:00"
                  },
                  {
                    "label": "Tempo",
                    "repeat": 1,
                    "workSeconds": 1200,
                    "workPace": "8:00"
                  },
                  {
                    "label": "Cool-down",
                    "repeat": 1,
                    "workSeconds": 600,
                    "workPace": "10:30"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
