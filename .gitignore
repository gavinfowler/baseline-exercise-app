# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Drift / build_runner
.dart_tool/build/
*.log

# Coverage
coverage/

# Play Store signing. The upload key is the app's identity: anyone holding it
# can publish an update as you, and losing it means asking Google to reset it.
# It must never be committed, on a public repo or a private one.
key.properties
*.jks
*.keystore

# Generated seed data. The script is the source of truth, not its output —
# committing a 3 MB file that `dart run tool/seed_data.dart` recreates would
# just make every regeneration a large, unreadable diff.
/tool/seed/

# Claude Code. Only the local parts: settings.local.json is one developer's
# permission allowlist and the screenshots are scratch output. A shared
# .claude/settings.json is meant to be committed, so the directory itself
# stays visible to git.
.claude/settings.local.json
.claude/screenshots/
