{
  "schemaVersion": "1.0",
  "plan": {
    "name": "Sample — Static Upper/Lower",
    "description": "Strength only, metric, weekly schedule. Exercises all four weight modes, a superset and a circuit. Use this to check that a static plan's baseline tracking, block kinds and weekday scheduling all import correctly.",
    "mode": "static",
    "units": "metric",
    "scheduleType": "weekly",
    "startDate": "2026-09-07",
    "days": [
      {
