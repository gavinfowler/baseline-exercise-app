        "blocks": [
          {
            "kind": "single",
            "label": "Main press",
            "rounds": 4,
            "restAfterRoundSeconds": 180,
            "exercises": [
              {
                "name": "Barbell Bench Press",
                "type": "strength",
                "reps": 5,
                "weight": 80,
                "weightMode": "baseline",
                "notes": "Starts at 80 kg and climbs whenever 5 reps are beaten at a heavier load."
              }
            ]
          },
          {
            "kind": "single",
            "label": "Back-off set",
            "rounds": 2,
            "restAfterRoundSeconds": 120,
            "exercises": [
              {
                "name": "Barbell Bench Press",
                "type": "strength",
                "reps": 8,
                "weightMode": "baselinePercent",
                "weightPercent": 85,
                "notes": "85% of whatever the working weight has reached."
              }
            ]
          },
          {
            "kind": "superset",
            "label": "Pull pair",
            "rounds": 3,
            "restBetweenExercisesSeconds": 15,
            "restAfterRoundSeconds": 120,
            "exercises": [
              {
                "name": "Barbell Row",
                "type": "strength",
                "reps": 8,
                "weight": 60,
                "weightMode": "baselinePlus",
                "weightOffset": 2.5,
                "notes": "Working weight plus 2.5 kg, recalculated each session."
              },
              {
                "name": "Face Pull",
                "type": "strength",
                "reps": 15,
                "weight": 20,
                "weightMode": "absolute",
                "rpe": 7
              }
            ]
          }
        ]
      },
      {
